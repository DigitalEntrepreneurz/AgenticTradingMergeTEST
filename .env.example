# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Set the key for the provider you chose in config/firm.yaml (llm.provider).
# Only one is needed. Leave the rest blank.

# provider: anthropic
ANTHROPIC_API_KEY=

# provider: openrouter  -- also set llm.model_prefix: anthropic in config/firm.yaml,
# otherwise agents ask for "claude-sonnet-4-5" and OpenRouter returns a 404.
OPENROUTER_API_KEY=

# provider: openai | groq | together | deepseek
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=

# Fallback used by any provider when its specific variable is empty.
LLM_API_KEY=

# ---------------------------------------------------------------------------
# MT4/MT5 bridge. Only needed for a real broker account; the simulated broker
# needs nothing. Paper trading stays on until BOTH paper_trading: false and
# allow_live_orders: true are set in config/firm.yaml.
# ---------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
